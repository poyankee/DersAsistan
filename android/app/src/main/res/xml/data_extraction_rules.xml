<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut yedeği ve cihaz aktarımında eşitleme anahtarı/oturumu taşınmaz -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="DaUpdater.xml" />
        <exclude domain="sharedpref" path="CapWebViewSettings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="DaUpdater.xml" />
        <exclude domain="sharedpref" path="CapWebViewSettings.xml" />
    </device-transfer>
</data-extraction-rules>
